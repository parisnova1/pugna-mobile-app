# Backend base URL. localhost works for Expo web preview and iOS Simulator;
# a physical device on Expo Go needs the dev machine's LAN IP instead
# (e.g. http://192.168.0.179:4000) since it can't resolve "localhost" to
# your machine.
EXPO_PUBLIC_API_URL=http://localhost:4000

# OAuth client IDs from Google Cloud Console (APIs & Services > Credentials).
# WEB is required for Expo web / Sign in with Google to work at all; IOS and
# ANDROID are only needed once building native standalone apps for those
# platforms. The same three values (without the EXPO_PUBLIC_ prefix) must
# also be set on the backend server as GOOGLE_CLIENT_ID_WEB / _IOS / _ANDROID
# so it can verify tokens against the right audience.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
